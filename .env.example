
# Chat (Gemini, then Groq, then OpenRouter)
GEMINI_API_KEY=

GROQ_API_KEY=

OPENROUTER_API_KEY=

# AI second opinion on photos and suggested treatment plan (free tiers). The Cloudflare token needs the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

COHERE_API_KEY=

MISTRAL_API_KEY=

# Optional: ask the AI on every scan instead of only when the result is unsure.
# NEXT_PUBLIC_ASSIST_MODE=always

# Optional model overrides (comma-separated lists are tried in order). Defaults were chosen by benchmark, see the README.
# CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct
# CLOUDFLARE_ADVICE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct
# COHERE_ADVICE_MODEL=command-a-03-2025
# MISTRAL_ADVICE_MODEL=ministral-8b-latest
# Models allowed to overrule the on-device result (backups can only confirm it).
# VISION_TRUSTED_MODELS=@cf/meta/llama-4-scout-17b-16e-instruct

GOOGLE_PLACES_API_KEY=

# ESP32-CAM as a photo source. The camera uploads its photos to this server and the phone fetches them from here.
# Camera codes (comma-separated, 16-128 characters of A-Z a-z 0-9 _ -): the same code goes into the camera's firmware
# config and into the app on the phone. Only listed codes work. Make one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ESP32_CAM_CODES=
# Where photos wait for a minute between camera and phone. In Vercel: Storage / Marketplace > Upstash Redis (free) sets
# the variables for you, as KV_REST_API_URL and KV_REST_API_TOKEN; those names work as they are (the read-only token
# is not used). Set the two names below only if you use Upstash outside Vercel's integration.
# Not needed for `npm run dev`, which keeps photos in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
